# Keep real values in an environment secret store or ignored local file.
# Use a separate database and secret for preview, never production identities.
DATABASE_URL=
# Optional direct database connection for operator-run migrations.
DATABASE_MIGRATION_URL=
# Cryptographically random secret, at least 32 characters. Never NEXT_PUBLIC_*.
BETTER_AUTH_SECRET=
# Exact origin, without a trailing slash. HTTPS except loopback development.
ADMIN_ORIGIN=
# Optional administrator invitation transport. Keep blank until owner setup approval.
# Server-only Resend sending-access key; restrict it to the verified sender domain.
RESEND_API_KEY=
# Bare email address on that domain; the application adds the NOSEE display name.
# Also requires the exact HTTPS ADMIN_ORIGIN above. Never use NEXT_PUBLIC_*.
ADMIN_INVITATION_FROM=
# Optional owner-operated membership expiry HTTP worker, independent of email.
# A random secret of at least 32 characters; never NEXT_PUBLIC_*.
CRON_SECRET=

# Membership mail is independent of administrator invitations and OFF by default.
MEMBERSHIP_EMAIL_ENABLED=false
# Bare verified sender address; requires existing RESEND_API_KEY and HTTPS ADMIN_ORIGIN.
MEMBERSHIP_EMAIL_FROM=
# Explicit comma-separated approved notification addresses (1–10 unique values).
MEMBERSHIP_EMAIL_ADMIN_RECIPIENTS=
# Owner-approved prospective UTC instant, ISO 8601; no disabled/historical backlog replay.
MEMBERSHIP_EMAIL_START_AT=
# Separate random worker bearer secret, 32–256 non-whitespace characters.
MEMBERSHIP_EMAIL_WORKER_SECRET=
