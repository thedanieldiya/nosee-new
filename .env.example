# Keep real values in an environment secret store or ignored local file.
# Use a separate database and secret for preview, never production identities.
DATABASE_URL=
# Optional direct database connection for operator-run migrations.
DATABASE_MIGRATION_URL=
# Cryptographically random secret, at least 32 characters. Never NEXT_PUBLIC_*.
BETTER_AUTH_SECRET=
# Exact origin, without a trailing slash. HTTPS except loopback development.
ADMIN_ORIGIN=
# Optional administrator invitation transport. Keep blank until owner setup approval.
# Server-only Resend sending-access key; restrict it to the verified sender domain.
RESEND_API_KEY=
# Bare email address on that domain; the application adds the NOSEE display name.
# Also requires the exact HTTPS ADMIN_ORIGIN above. Never use NEXT_PUBLIC_*.
ADMIN_INVITATION_FROM=
