{
  "name": "nosee-new",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "admin:migrate": "node --env-file-if-exists=.env.local scripts/admin-migrate.mjs",
    "admin:bootstrap": "node --conditions=react-server --env-file-if-exists=.env.local scripts/admin-bootstrap.mjs",
    "test:admin": "node --conditions=react-server --env-file-if-exists=.env.local --test --test-concurrency=1 tests/admin-integration.mjs tests/admin-management-integration.mjs",
    "test:admin-mail": "node --conditions=react-server --test tests/admin-resend.mjs",
    "membership:expire": "node --conditions=react-server --env-file-if-exists=.env.local scripts/membership-expire.mjs",
    "test:membership": "node --conditions=react-server --env-file-if-exists=.env.local --test tests/membership-integration.mjs",
    "test:members": "node --conditions=react-server --env-file-if-exists=.env.local --test tests/members-integration.mjs",
    "membership:mail": "node --conditions=react-server --env-file-if-exists=.env.local scripts/membership-email-worker.mjs",
    "test:membership-mail": "node --conditions=react-server --env-file-if-exists=.env.local --test tests/membership-email-integration.mjs",
    "test:mail": "node --conditions=react-server --test tests/admin-resend.mjs tests/membership-email.mjs",
    "test:membership-workflow": "node --conditions=react-server --env-file-if-exists=.env.local --test tests/membership-workflow-integration.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@fontsource/ubuntu-sans": "5.2.8",
    "@inquirer/input": "5.1.7",
    "@inquirer/password": "5.2.3",
    "@mingcute/react": "3.0.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "better-auth": "1.7.9",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
